+/* Quest KGSL may sleep for WAITTIMESTAMP with timeout=0. Export the
+ * timestamp as a sync fence and poll it instead. Only POLLIN without an
+ * error proves completion; a failed export or fence must not release work.
+ */
+static VkResult
+poll_timestamp_safe(int fd, unsigned int context_id, unsigned int timestamp)
+{
+   int fence_fd = -1;
+   struct kgsl_timestamp_event event = {
+      .type = KGSL_TIMESTAMP_EVENT_FENCE,
+      .timestamp = timestamp,
+      .context_id = context_id,
+      .priv = &fence_fd,
+      .len = sizeof(fence_fd),
+   };
+   if (safe_ioctl(fd, IOCTL_KGSL_TIMESTAMP_EVENT, &event) || fence_fd < 0)
+      return VK_ERROR_DEVICE_LOST;
+
+   struct pollfd fence = { .fd = fence_fd, .events = POLLIN, .revents = 0 };
+   int ret = poll(&fence, 1, 0);
+   int poll_errno = errno;
+   close(fence_fd);
+
+   if ((ret < 0 && poll_errno != EINTR) ||
+       (fence.revents & (POLLERR | POLLNVAL | POLLHUP)))
+      return VK_ERROR_DEVICE_LOST;
+
+   return ret > 0 && (fence.revents & POLLIN) ? VK_SUCCESS : VK_TIMEOUT;
+}
