+/* Acquire an existing immutable binary before sizing private shader memory.
+ * A miss performs no allocation and preserves the original upload path. */
+static uint64_t
+tu_lookup_binning_preupload(tu_device *dev, const ir3_shader_variant *v,
+                           tu_binning_binary **reference)
+{
+   assert(!*reference);
+   if (!v || v->type != MESA_SHADER_VERTEX) return 0;
+   pthread_mutex_lock(&dev->pipeline_mutex);
+   auto *cache = dev->binning_binary_cache;
+   uint64_t address = 0;
+   if (cache) {
+      const tu_binning_binary_key key = {
+         _mesa_hash_data(v->bin, v->info.size), v->info.size,
+         v->info.double_threadsize, v->bin,
+      };
+      if (auto *entry = _mesa_hash_table_search(cache->table, &key)) {
+         auto *binary = static_cast<tu_binning_binary *>(entry->data);
+         if (binary->refs != UINT32_MAX) {
+            ++binary->refs;
+            ++cache->hits;
+            ++cache->preupload_hits;
+            *reference = binary;
+            address = binary->iova;
+         }
+      }
+   }
+   pthread_mutex_unlock(&dev->pipeline_mutex);
+   return address;
+}
+
+/* Upload failure must not strand references acquired before allocation. */
+static void
+tu_abandon_binning_preuploads(tu_device *dev, tu_binning_binary **references)
+{
+   pthread_mutex_lock(&dev->pipeline_mutex);
+   for (unsigned i = 0; i < 2; ++i) {
+      tu_release_binning_binary(dev, references[i]);
+      references[i] = NULL;
+   }
+   pthread_mutex_unlock(&dev->pipeline_mutex);
+}
+
+static void
+tu_account_binning_preuploads(tu_device *dev, uint32_t bytes)
+{
+   if (!bytes) return;
+   pthread_mutex_lock(&dev->pipeline_mutex);
+   auto *cache = dev->binning_binary_cache;
+   ++cache->successful_skips;
+   cache->avoided_upload_bytes += bytes;
+   if (cache->successful_skips <= 8 || !(cache->successful_skips % 128))
+      mesa_logi("ALYX_BINNING_UPLOAD_REUSE shaders=%llu bytes=%llu scope=successful-suballocation-and-upload-bytes",
+         (unsigned long long)cache->successful_skips,
+         (unsigned long long)cache->avoided_upload_bytes);
+   pthread_mutex_unlock(&dev->pipeline_mutex);
+}
