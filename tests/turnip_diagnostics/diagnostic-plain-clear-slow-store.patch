--- a/src/freedreno/vulkan/tu_clear_blit.cc
+++ b/src/freedreno/vulkan/tu_clear_blit.cc
@@ -5690,6 +5690,14 @@
    struct tu_physical_device *phys_dev = cmd->device->physical_device;
    const struct tu_image_view *iview = cmd->state.attachments[a];

+   /* Diagnostic: A7xx fast stores can leave previous contents in cleared
+    * blocks of a reused non-FDM attachment. Keep other passes on fast STORE.
+    * Returning true here also selects the CCU-safe layout before rendering.
+    */
+   if (phys_dev->info->chip == 7 && !cmd->state.pass->has_fdm &&
+       cmd->state.pass->attachments[a].clear_mask)
+      return true;
+
    /* Unaligned store is incredibly rare in CTS, we have to force it to test. */
    if (TU_DEBUG(UNALIGNED_STORE))
       return true;
