+   tu_cs_emit(cs, ~0u);
+   tu_cs_emit(cs, gras_cs_bin_cntl.value);
+
+   tu_cs_emit_pkt7(cs, CP_REG_RMW, 3);
+   tu_cs_emit(cs, CP_REG_RMW_0_DST_REG(rb_cntl.reg));
+   tu_cs_emit(cs, ~0u);
+   tu_cs_emit(cs, rb_cntl.value);
+
+   tu_cond_exec_end(cs);
