+/* The firmware skips identical PROGRAM_CONFIG groups. Shader groups carry
+ * DIRTY because a changed configuration invalidates their CP_LOAD_STATE data.
+ * If the immutable configuration and a shader group are both unchanged, no
+ * intervening draw-state reset requires reloading that group at this bind.
+ * Keep descriptor preloads, dynamic constants and all other state unchanged.
+ */
+static bool
+alyx_same_immutable_state(const tu_draw_state &a, const tu_draw_state &b)
+{
+   return !a.writeable && !b.writeable && a.iova == b.iova && a.size == b.size;
+}
+
+static void
+alyx_state_reuse_stats(bool config_same, uint32_t skipped, uint32_t nonempty,
+                      bool binning_skipped)
+{
+   /* CPU-only cumulative counters, separated by logcat TID. Not GPU timing. */
+   static thread_local struct {
+      uint64_t binds, eligible, slots, nonempty, binning;
+   } stats;
+   stats.binds++;
+   stats.eligible += config_same;
+   stats.slots += util_bitcount(skipped);
+   stats.nonempty += nonempty;
+   stats.binning += binning_skipped;
+   if (stats.binds <= 4 || !(stats.binds % 16384))
+      mesa_logi("ALYX_STATE_REUSE binds=%llu eligible=%llu skipped=%llu nonempty=%llu vsBinning=%llu scope=cpu-bind-counts",
+         (unsigned long long)stats.binds, (unsigned long long)stats.eligible,
+         (unsigned long long)stats.slots, (unsigned long long)stats.nonempty,
+         (unsigned long long)stats.binning);
+}
