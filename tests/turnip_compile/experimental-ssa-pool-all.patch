@@ -0,0 +1,33 @@
+/* Scratch storage for ir3_find_ssa_uses_for's SSA use sets.
+ * Current callers free parent contexts, never individual instr->uses sets.
+ * Expansion tables belong to that parent too. No optimizer rule is changed.
+ */
+#ifndef ALYX_IR3_USE_POOL_H
+#define ALYX_IR3_USE_POOL_H
+#include "util/ralloc.h"
+#include "util/set.h"
+
+struct alyx_ir3_use_pool {
+   void *mem_ctx;
+   struct set *slab;
+   unsigned used;
+};
+
+static inline struct set *
+alyx_ir3_use_set(struct alyx_ir3_use_pool *pool)
+{
+   const unsigned capacity = 128;
+   if (!pool->slab || pool->used == capacity) {
+      struct set *next = ralloc_array(pool->mem_ctx, struct set, capacity);
+      /* If a larger allocation fails, retain the original small-allocation
+       * behavior. Do not reuse/overwrite a full slab. */
+      if (!next)
+         return _mesa_pointer_set_create(pool->mem_ctx);
+      pool->slab = next;
+      pool->used = 0;
+   }
+   struct set *set = &pool->slab[pool->used++];
+   _mesa_pointer_set_init(set, pool->mem_ctx);
+   return set;
+}
+#endif
